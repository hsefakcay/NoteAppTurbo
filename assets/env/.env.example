# Backend API Configuration
# Note App Turbo Backend API base URL

# Local Development (iOS Simulator / macOS / Linux / Windows)
API_BASE_URL=http://127.0.0.1:8000

# Android Emulator (uncomment if using Android Emulator)
# API_BASE_URL=http://10.0.2.2:8000

# Production (uncomment and update for production)
# API_BASE_URL=https://your-production-api.com

# API Path Prefix
API_PATH_PREFIX=/api

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 1. Copy this file and rename it to .env
#    cp assets/env/.env.example assets/env/.env
#
# 2. Update API_BASE_URL based on your platform:
#    - iOS Simulator/macOS: http://127.0.0.1:8000
#    - Android Emulator: http://10.0.2.2:8000
#    - Physical Device: http://<your-local-ip>:8000
#    - Production: https://your-production-api.com
#
# 3. Make sure the backend server is running on port 8000
#
# 4. The .env file is gitignored for security
# ============================================
